# Copy to .env. The defaults match docker-compose.yml and need no edits to run locally.
# Every setting is also a flag (-log-level) and a JSON key ("log-level"); flags win,
# then the environment, then the file NERVE_CONFIG names, then these defaults.
# NERVE_CONFIG=nerve.json
NERVE_POSTGRES_DSN=postgres://nerve:nerve@localhost:5432/nerve?sslmode=disable
NERVE_RABBITMQ_URL=amqp://nerve:nerve@localhost:5672/
NERVE_OLLAMA_URL=http://localhost:11434
NERVE_LOG_LEVEL=info
