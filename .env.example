# Copy to .env. The defaults match docker-compose.yml and need no edits to run locally.
# Both `make up` and `make run` read this file, so a port is spelled once here and the
# URLs below follow it.
# Every setting is also a flag (-log-level) and a JSON key ("log-level"); flags win,
# then the environment, then the file NERVE_CONFIG names, then these defaults.
# NERVE_CONFIG=nerve.json

# Host ports. Change one if it is already taken; nothing else needs editing.
NERVE_POSTGRES_PORT=5432
NERVE_RABBITMQ_PORT=5672
NERVE_RABBITMQ_UI_PORT=15672
NERVE_OLLAMA_PORT=11434
# Only used by `make observe`. Nothing is exported until NERVE_TELEMETRY_ENDPOINT is set.
NERVE_OTLP_PORT=4317
NERVE_GRAFANA_PORT=3000

NERVE_POSTGRES_DSN=postgres://nerve:nerve@localhost:${NERVE_POSTGRES_PORT}/nerve?sslmode=disable
NERVE_RABBITMQ_URL=amqp://nerve:nerve@localhost:${NERVE_RABBITMQ_PORT}/
NERVE_OLLAMA_URL=http://localhost:${NERVE_OLLAMA_PORT}
NERVE_LOG_LEVEL=info
# Uncomment with `make observe` running to send traces, metrics and logs to it.
# NERVE_TELEMETRY_ENDPOINT=http://localhost:${NERVE_OTLP_PORT}
